generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  mfaSecret     String?
  isMfaEnabled  Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?  // Soft delete
  employee      Employee?
  roles         UserRole[]
}

model Employee {
  id              String         @id @default(uuid())
  userId          String?        @unique
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeId      String         @unique
  firstName       String
  lastName        String
  preferredName   String?
  profilePicture  String?

  // Contact
  email           String?
  phone           String?
  secondaryPhone  String?
  address         String?
  emergencyContact String?

  // Employment
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  position        String?
  managerId       String?
  manager         Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates    Employee[]    @relation("EmployeeManager")
  status          EmployeeStatus @default(ACTIVE)
  startDate       DateTime?
  endDate         DateTime?
  internalNotes   String?

  socialLinks     EmployeeSocial[]
  documents       Document[]
  credentials     Credential[]
  customValues    CustomFieldValue[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?      // Soft delete

  @@index([firstName])
  @@index([lastName])
  @@index([employeeId])
}

model EmployeeSocial {
  id         String    @id @default(uuid())
  employeeId String
  platform   String    // e.g., "LinkedIn", "GitHub"
  url        String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, platform])
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?  // Soft delete
}

model Document {
  id              String            @id @default(uuid())
  employeeId      String
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  categoryId      String
  category        DocumentCategory  @relation(fields: [categoryId], references: [id])
  originalName    String
  storageKey      String            @unique // Randomized identifier
  mimeType        String
  size            Int
  uploaderId      String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?         // Soft delete
}

model DocumentCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  documents Document[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Credential {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  label           String   // e.g., "AWS Root Account"
  encryptedDEK    String   // The Data Encryption Key encrypted by the Master Key
  dekIv           String   // IV for DEK encryption
  dekTag          String   // Tag for DEK encryption
  encryptedValue  String   // The secret value encrypted by the DEK
  iv              String   // IV for Value encryption
  tag             String   // Tag for Value encryption
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?  // Soft delete

  @@unique([employeeId, label])
}

model AuditLog {
  id        String   @id @default(uuid())
  eventType String   // e.g., "auth.login", "employee.create"
  actorId   String?  // User ID of the person who performed the action
  targetId  String?  // ID of the affected resource
  result    String   // "SUCCESS" or "FAILURE"
  ipAddress String?
  userAgent String?
  metadata  Json?    // Additional context
  timestamp DateTime @default(now())

  @@index([eventType])
  @@index([targetId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id    String           @id @default(uuid())
  slug  String           @unique
  roles RolePermission[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model CustomField {
  id          String            @id @default(uuid())
  name        String
  type        FieldType
  isRequired  Boolean           @default(false)
  values      CustomFieldValue[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  MULTI_SELECT
  URL
}

model CustomFieldValue {
  id         String   @id @default(uuid())
  fieldId    String
  employeeId String
  value      String   // Stored as string, casted by application logic
  field      CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([fieldId, employeeId])
}
